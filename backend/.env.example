APP_NAME=Learnia API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=sqlite:///./learnia.db

# Which login options (AuthStrategy ids) are active — see auth/registry.py.
AUTH_ENABLED_STRATEGIES=["password"]

# Global session mechanism, shared by every enabled strategy.
AUTH_SESSION_MODE=cookie_session

SESSION_TTL_MINUTES=10080
SESSION_COOKIE_NAME=learnia_session

# Login protection (Phase B)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_FAILED_PER_IP=20

# Email: "console" prints emails in the log; "smtp" really sends them.
EMAIL_BACKEND=console
EMAIL_FROM=Learnia <you@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
# Gmail: create an "App password" (Google Account > Security > 2-Step Verification).
SMTP_PASSWORD=
FRONTEND_BASE_URL=http://localhost:5173
