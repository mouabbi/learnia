APP_NAME=Learnia API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=sqlite:///./learnia.db

# Which login options (AuthStrategy ids) are active — see auth/registry.py.
AUTH_ENABLED_STRATEGIES=["password"]

# Global session mechanism, shared by every enabled strategy.
AUTH_SESSION_MODE=cookie_session

SESSION_TTL_MINUTES=10080
SESSION_COOKIE_NAME=learnia_session
