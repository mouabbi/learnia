# Copy to /opt/learnia/backend.env ON THE VPS (not in git), fill it, chmod 600.
# Backend runtime secrets (all options: backend/.env.example).
# DATABASE_URL, CORS_ORIGINS, FRONTEND_BASE_URL, ENVIRONMENT are set by
# docker-compose.prod.yml — don't put them here.

APP_NAME=Learnia API

# REQUIRED — a NEW key, never the dev default. Generate one on the VPS:
#   openssl rand -base64 32 | tr '+/' '-_'
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Learnia

# Real emails (password reset, verification). "console" = only printed in logs.
EMAIL_BACKEND=smtp
EMAIL_FROM=Learnia <you@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
