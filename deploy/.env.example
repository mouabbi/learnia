# Copy to /opt/learnia/.env ON THE VPS (never in git).
# docker compose reads it (--env-file .env) to fill ${...} in docker-compose.prod.yml.
DOMAIN=learnia.tisfoulla.com
DOCKERHUB_USERNAME=mouabbi
# Port on 127.0.0.1 where the frontend container listens.
# Must be free on the VPS and match proxy_pass in nginx-host.conf.
APP_PORT=5555
